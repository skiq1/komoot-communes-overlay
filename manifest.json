{
  "manifest_version": 3,
  "name": "ZaliczGmine.pl - overlay",
  "version": "0.0.1",
  "description": "Wyswietlaj zaliczone gminy na mapach planerów tras.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.komoot.com/*",
    "*://*.komoot.de/*",
    "*://*.komoot.es/*",
    "*://*.komoot.fr/*",
    "*://*.komoot.it/*",
    "*://*.komoot.nl/*",
    "*://veloplanner.com/*",
    "*://zaliczgmine.pl/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png"
    },
    "default_title": "Zalicz Gminy"
  },
  "icons": {
    "16": "assets/icons/icon16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.komoot.com/*",
        "*://*.komoot.de/*",
        "*://*.komoot.es/*",
        "*://*.komoot.fr/*",
        "*://*.komoot.it/*",
        "*://*.komoot.nl/*",
        "*://veloplanner.com/*"
      ],
      "js": [
        "message-protocol.js",
        "modules/sites.js",
        "content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.komoot.com/*",
        "*://*.komoot.de/*",
        "*://*.komoot.es/*",
        "*://*.komoot.fr/*",
        "*://*.komoot.it/*",
        "*://*.komoot.nl/*",
        "*://veloplanner.com/*"
      ],
      "resources": [
        "message-protocol.js",
        "config.js",
        "modules/sites.js",
        "modules/extension-bridge.js",
        "modules/zaliczgmine-api.js",
        "modules/map-finder.js",
        "modules/communes-data.js",
        "modules/map-layers.js",
        "modules/gpx.js",
        "map-app.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
